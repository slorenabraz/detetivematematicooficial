# =============================================================================
# VARIÁVEIS DE AMBIENTE (MESMOS NOMES NA VERCEL E NO AI STUDIO)
# =============================================================================

# GEMINI_API_KEY: Chave privada para eventuais chamadas server-side à API Gemini.
# Mantida estritamente fora do bundle do navegador por segurança.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a plataforma está hospedada (Vercel ou AI Studio).
# Fallback automático: APP_URL -> VERCEL_URL -> window.location.origin.
APP_URL="MY_APP_URL"
